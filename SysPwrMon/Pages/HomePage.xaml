<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SysPwrMon.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SysPwrMon.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:PercentValueConverter x:Key="PercentValueConverter" />
        <converters:WattValueConverter x:Key="WattValueConverter" />
        <converters:MebibyteValueConverter x:Key="MebibyteValueConverter" />
        <Style x:Key="LoadBarStyle" TargetType="ProgressBar">
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Width" Value="120" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Maximum" Value="100" />
        </Style>
    </Page.Resources>
    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="System Power" />

            <!-- Logging toggle + one-line status. The checkbox state is
                 owned by TelemetryService; the handler only forwards it. -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox
                    x:Name="LoggingCheckBox"
                    VerticalAlignment="Center"
                    Checked="LoggingCheckBox_Checked"
                    Content="Log to MongoDB"
                    Unchecked="LoggingCheckBox_Unchecked" />
                <TextBlock
                    x:Name="StatusTextBlock"
                    Text=""
                    VerticalAlignment="Center" />
            </StackPanel>
            <Border Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Total Load" />
                    <TextBlock
                        x:Name="SystemTotalPower"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="0 W" />
                </Grid>
            </Border>
            <!-- CPU: DataContext bound to the stable CpuTelemetry; the
                 timer thread mutates it, bindings pick up the values. -->
            <!-- Column widths (100, *, 100, *) MUST match the GPU cards' grid:
                 the grids are independent, so Auto label columns would size to
                 each card's own widest label and drift across cards. -->
            <Border x:Name="CpuCard" Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.ColumnSpan="4"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="CPU Load" />
                    <!-- Load value + display-only bar: same bound value, 0-100 scale.
                         ProgressBar needs Maximum=100: the WinUI 3 default is 10. -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{Binding Load, Converter={StaticResource PercentValueConverter}}" />
                        <ProgressBar
                            Style="{StaticResource LoadBarStyle}"
                            Value="{Binding Load}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="CPU Power" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="3"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{Binding Power, Converter={StaticResource WattValueConverter}}" />
                </Grid>
            </Border>

            <!-- One card per GPU; the items are the stable GpuTelemetry
                 objects, so in-place updates flow through every binding. -->
            <ItemsControl x:Name="GpuItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Margin="0,0,0,16">
                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <!-- Label columns fixed at 100 to match the CPU
                                     card: Auto would drift across the independent
                                     grids (see CpuCard comment). -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.ColumnSpan="4"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Core Load" />
                                <!-- Core load value + display-only bar (same bound value). -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding CoreLoad, Converter={StaticResource PercentValueConverter}}" />
                                    <ProgressBar
                                        Style="{StaticResource LoadBarStyle}"
                                        Value="{Binding CoreLoad}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="Core Power" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding CorePower, Converter={StaticResource WattValueConverter}}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="VRAM Free" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding VramFreeMiB, Converter={StaticResource MebibyteValueConverter}}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="VRAM Used" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding VramUsedMiB, Converter={StaticResource MebibyteValueConverter}}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="VRAM Load" />
                                <!-- VRAM load value + display-only bar (same bound value). -->
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{Binding VramLoad, Converter={StaticResource PercentValueConverter}}" />
                                    <ProgressBar
                                        Style="{StaticResource LoadBarStyle}"
                                        Value="{Binding VramLoad}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="VRAM Max" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="3"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{Binding VramMaxMiB, Converter={StaticResource MebibyteValueConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
