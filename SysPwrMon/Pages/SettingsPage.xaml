<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SysPwrMon.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel MaxWidth="520" Spacing="8">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />
            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="MongoDB connection settings are stored in the Windows registry." />

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="MONGODB_URI" />
            <TextBox x:Name="MongoUriTextBox" />

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="DB_NAME" />
            <TextBox x:Name="DatabaseNameTextBox" />

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="COLLECTION_NAME" />
            <TextBox x:Name="CollectionNameTextBox" />

            <!-- Minimize-to-tray: a behavior toggle persisted alongside the
                 MongoDB connection values (its own registry DWORD). -->
            <CheckBox
                x:Name="MinimizeToTrayCheckBox"
                Content="Minimize to system tray" />

            <Button
                Content="Save"
                HorizontalAlignment="Left"
                Padding="16,4,16,4"
                Click="OnSave" />

            <TextBlock x:Name="SaveStatusTextBlock" Text="" />

        </StackPanel>
    </ScrollViewer>
</Page>
